<Window x:Class="LinuxReader.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Linux File Reader for Windows (Strict Read-Only)" 
        Icon="Assets/app.ico"
        Height="760" Width="1180" MinHeight="540" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Title -->
            <RowDefinition Height="Auto"/> <!-- Action Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="36" Height="36" Margin="0,0,12,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Linux File Reader for Windows" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Safe, Direct, Non-Destructive Ext2/Ext3/Ext4 Access" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges & Admin Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Admin Status Indicator -->
                    <Border x:Name="BadgeAdminStatus" Background="#065F46" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtAdminIcon" Text="🛡️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdminStatus" Text="ADMINISTRATOR MODE" FontWeight="Bold" FontSize="11" Foreground="#34D399" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnElevate" Content="🛡️ Restart as Administrator" Click="BtnElevate_Click" Visibility="Collapsed"
                            Padding="10,4" Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Strict Read-Only Badge -->
                    <Border Background="#1E3A8A" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STRICT READ-ONLY" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Action Toolbar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpenImage" Content="📂 Open Disk Image..." Click="BtnOpenImage_Click" 
                            Padding="12,6" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnScanDrives" Content="🔍 Scan Physical Hard Drives" Click="BtnScanDrives_Click" 
                            Padding="12,6" Background="#0F172A" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Separator Width="1" Background="#CBD5E1" Margin="8,4"/>

                    <Button x:Name="BtnExport" Content="💾 Export Selected..." Click="BtnExport_Click" 
                            Padding="12,6" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="💡 Tip: Drag &amp; drop any .img, .iso, or .raw disk file here" 
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </Grid>
        </Border>

        <!-- 3. Main Workspace Splitter -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Disks, Partitions & Folder Navigation -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Disks &amp; Partitions" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbSources" Grid.Row="1" SelectionChanged="CmbSources_SelectionChanged" 
                              DisplayMemberPath="DisplayName" Margin="0,0,0,10" Height="28"/>

                    <TextBlock Grid.Row="2" Text="Directory Navigation" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>

                    <TreeView x:Name="DirTreeView" Grid.Row="3" SelectedItemChanged="DirTreeView_SelectedItemChanged" BorderThickness="0"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" Width="4"/>

            <!-- Center Panel: Files List View -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb path bar and search -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clickable Interactive Breadcrumbs -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PanelBreadcrumbs" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📁 /" Padding="4,2" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <TextBox x:Name="TxtSearch" Grid.Column="1" TextChanged="TxtSearch_TextChanged" 
                                 Padding="6,4" ToolTip="Filter files in current folder..."/>
                    </Grid>

                    <!-- Files Table with Context Menu -->
                    <ListView x:Name="LstFiles" Grid.Row="1" SelectionChanged="LstFiles_SelectionChanged" 
                              MouseDoubleClick="LstFiles_MouseDoubleClick" BorderThickness="0">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxOpenDefault" Header="🚀 Open with Windows Default App" Click="CtxOpenDefault_Click"/>
                                <MenuItem x:Name="CtxExport" Header="💾 Export to Windows Folder..." Click="BtnExport_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxCopyPath" Header="📋 Copy Linux Path" Click="CtxCopyPath_Click"/>
                                <MenuItem x:Name="CtxCopyContent" Header="📄 Copy File Content" Click="CtxCopyContent_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxProperties" Header="ℹ️ View Inode &amp; Metadata Details" Click="CtxProperties_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding FormattedSize}"/>
                                <GridViewColumn Header="Permissions" Width="100" DisplayMemberBinding="{Binding Permissions}"/>
                                <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedFormatted}"/>
                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding FileTypeName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E2E8F0" Width="4"/>

            <!-- Right Panel: Multi-Format Preview & Inspector -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Item Inspector" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                    <StackPanel x:Name="PanelDetails" Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtDetailName" Text="No item selected" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDetailPath" Text="" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <TextBlock x:Name="TxtDetailSize" Text="" Foreground="#334155" FontSize="12"/>
                        <TextBlock x:Name="TxtDetailPerms" Text="" Foreground="#334155" FontSize="12"/>
                        <TextBlock x:Name="TxtDetailInode" Text="" Foreground="#334155" FontSize="12"/>
                    </StackPanel>

                    <!-- Multi-Format Previewer (Text, Hex, Image) -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- View Selector Tabs -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4,4,0,0" Padding="4,3" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbViewText" Content="📝 Text" IsChecked="True" Checked="RbViewMode_Checked" Margin="4,2,8,2" FontSize="11" Cursor="Hand"/>
                                <RadioButton x:Name="RbViewHex" Content="🔢 Hex" Checked="RbViewMode_Checked" Margin="0,2,8,2" FontSize="11" Cursor="Hand"/>
                                <RadioButton x:Name="RbViewImage" Content="🖼️ Image" Checked="RbViewMode_Checked" Margin="0,2,4,2" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview Container -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="0,0,4,4" Padding="8">
                            <Grid>
                                <!-- Text & Hex Dump Viewer -->
                                <ScrollViewer x:Name="ScrollTextHex" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtPreview" Text="// File Preview will appear here..." 
                                             Background="Transparent" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="11" 
                                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                                </ScrollViewer>

                                <!-- Image Viewer -->
                                <ScrollViewer x:Name="ScrollImage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Vertical">
                        <Button x:Name="BtnOpenWith" Content="🚀 Open in Windows App" Click="BtnOpenWith_Click"
                                Padding="10,6" Background="#0F172A" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False" Margin="0,0,0,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnQuickExport" Content="⬇️ Export to Windows Folder" Click="BtnExport_Click"
                                Padding="10,6" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False" Margin="0,0,0,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnCopyPath" Content="📋 Copy Linux Path" Click="BtnCopyPath_Click"
                                Padding="10,4" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" IsEnabled="False" FontSize="11">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <StatusBar Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Ready. Open an image or scan physical drives to begin." Foreground="#64748B"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Immutable Read Access Active" Foreground="#059669" FontWeight="Medium" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
